<Page
    x:Class="Formulario_1.FormularioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Formulario_1"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- CONTENEDOR PRINCIPAL -->
    <Grid Background="#F4F6F8">

        <!-- ========================================================= -->
        <!--                RECURSOS Y ESTILOS GLOBALES                -->
        <!-- ========================================================= -->
        <Grid.Resources>

            <!-- Colores para estados de controles -->
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="Black" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="Black" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="White" />

            <!-- Estilo global para textos -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="Black"/>
            </Style>

            <!-- Estilo para cajas de texto -->
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>

            <!-- Estilo para contraseñas -->
            <Style TargetType="PasswordBox">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- Estilo para checkboxes -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="Black"/>
            </Style>

            <!-- Estilo para fechas -->
            <Style TargetType="DatePicker">
                <Setter Property="Foreground" Value="Black"/>
            </Style>

        </Grid.Resources>

        <!-- ========================================================= -->
        <!--                     SCROLL GENERAL                        -->
        <!-- ========================================================= -->
        <ScrollViewer>
            <StackPanel Padding="30" Spacing="25">

                <!-- ===== TÍTULO ===== -->
                <StackPanel>
                    <TextBlock Text="FORMULARIO DE REGISTRO"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#00796B"/>
                </StackPanel>

                <!-- ========================================================= -->
                <!--                      SECCIÓN CITA                         -->
                <!-- ========================================================= -->
                <Border Background="White" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="10">

                        <TextBlock Text="Asignación de cita"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#00796B"/>

                        <TextBlock x:Name="txtIdCita"
                                   Text="Folio de cita: "
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#00796B"/>

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!-- DOCTOR -->
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="Doctor *"/>
                                <ComboBox x:Name="cbDoctores" SelectedIndex="0" Foreground="Black" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="-- Selecciona un doctor  --" IsEnabled="False"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- FECHA -->
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="Fecha *"/>
                                <CalendarDatePicker x:Name="dpCita"
                                                    HorizontalAlignment="Stretch"
                                                    PlaceholderText="-- Selecciona fecha --"
                                                    Foreground="Black"/>
                            </StackPanel>

                            <!-- HORA -->
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Text="Hora *"/>
                                <ComboBox x:Name="cbHora" SelectedIndex="0" Foreground="Black" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="-- Hora --" IsEnabled="False"/>
                                    <ComboBoxItem Content="09:00 - 10:00"/>
                                    <ComboBoxItem Content="10:00 - 11:00"/>
                                    <ComboBoxItem Content="11:00 - 12:00"/>
                                    <ComboBoxItem Content="12:00 - 13:00"/>
                                    <ComboBoxItem Content="-- Hora de comida --" IsEnabled="False"/>
                                    <ComboBoxItem Content="14:00 - 15:00"/>
                                    <ComboBoxItem Content="15:00 - 16:00"/>
                                    <ComboBoxItem Content="16:00 - 17:00"/>
                                </ComboBox>
                            </StackPanel>

                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========================================================= -->
                <!--                SECCIÓN: DATOS DEL PACIENTE                -->
                <!-- ========================================================= -->
                <Border Background="White" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="15">

                        <TextBlock Text="Datos del paciente"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#00796B"/>

                        <Grid ColumnSpacing="15" RowSpacing="15">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <!-- NOMBRE -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
                                <TextBlock Text="Nombre completo *"/>
                                <TextBox x:Name="txtNombre" Height="40"/>
                            </StackPanel>

                            <!-- TELÉFONO -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
                                <TextBlock Text="Teléfono *"/>
                                <TextBox x:Name="txtTelefono" Height="40" MaxLength="10"/>
                            </StackPanel>

                            <!-- NACIMIENTO -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                                <TextBlock Text="Nacimiento *"/>
                                <CalendarDatePicker x:Name="dpNacimiento"
                                                    HorizontalAlignment="Stretch"
                                                    PlaceholderText="-- Selecciona fecha --"
                                                    Foreground="Black"/>
                            </StackPanel>

                            <!-- CORREO -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                                <TextBlock Text="Correo"/>
                                <TextBox x:Name="txtCorreo" Height="40"/>
                            </StackPanel>

                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- ========================================================= -->
                <!--                 SECCIÓN: HISTORIAL MÉDICO                 -->
                <!-- ========================================================= -->
                <Border Background="White" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="15">

                        <TextBlock Text="Historial médico"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#00796B"/>

                        <!-- ENFERMEDADES -->
                        <TextBlock Text="¿Tiene enfermedades crónicas?"/>
                        <StackPanel Orientation="Horizontal" Spacing="30">

                            <CheckBox x:Name="chkEnfSi"
                                      Checked="chkEnfSi_Checked"
                                      Unchecked="chkEnfSi_Unchecked">
                                <TextBlock Text="Sí" Foreground="Black"/>
                            </CheckBox>

                            <CheckBox x:Name="chkEnfNo"
                                      Checked="chkEnfNo_Checked">
                                <TextBlock Text="No" Foreground="Black"/>
                            </CheckBox>

                        </StackPanel>

                        <TextBox x:Name="txtenfermedades"
                                 Visibility="Collapsed"
                                 PlaceholderText="Especifique enfermedades"/>

                        <!-- CIRUGÍAS -->
                        <TextBlock Text="¿Ha tenido cirugías mayores?"/>
                        <StackPanel Orientation="Horizontal" Spacing="30">

                            <CheckBox x:Name="chkCirSi"
                                      Checked="chkCirSi_Checked"
                                      Unchecked="chkCirSi_Unchecked">
                                <TextBlock Text="Sí" Foreground="Black"/>
                            </CheckBox>

                            <CheckBox x:Name="chkCirNo"
                                      Checked="chkCirNo_Checked">
                                <TextBlock Text="No" Foreground="Black"/>
                            </CheckBox>

                        </StackPanel>

                        <TextBox x:Name="txtcirugias"
                                 Visibility="Collapsed"
                                 PlaceholderText="Especifique cirugías"/>

                        <!-- OTROS DATOS -->
                        <TextBlock Text="Medicamentos actuales"/>
                        <TextBox x:Name="txtMedicamentos"/>

                        <TextBlock Text="Alergias"/>
                        <TextBox x:Name="txtAlergias"/>

                    </StackPanel>
                </Border>

                <!-- ========================================================= -->
                <!--                      SECCIÓN: MOTIVO                      -->
                <!-- ========================================================= -->
                <Border Background="White" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="15">

                        <TextBlock Text="Motivo de la consulta"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#00796B"/>

                        <TextBox x:Name="txtMotivo"
                                 AcceptsReturn="True"
                                 Height="100"/>

                    </StackPanel>
                </Border>

                <!-- ===== BOTÓN GUARDAR ===== -->
                <Button Content="Guardar información"
                        Click="btnGuardar_Click"
                        HorizontalAlignment="Stretch"
                        Height="50"
                        Background="#00796B"
                        Foreground="White"
                        FontSize="16"
                        CornerRadius="8"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>