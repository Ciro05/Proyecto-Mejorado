<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Formulario_1.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Formulario_1"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#F4F6F8">

        <!-- ============================================================ -->
        <!--                  RECURSOS Y ESTILOS GLOBALES                 -->
        <!-- ============================================================ -->
        <Grid.Resources>
            <SolidColorBrush x:Key="TextControlForegroundPointerOver"   Color="Black"/>
            <SolidColorBrush x:Key="TextControlForegroundFocused"       Color="Black"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver"   Color="White"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused"       Color="White"/>

            <Style TargetType="DatePicker">
                <Setter Property="Foreground"  Value="Black"/>
                <Setter Property="Background"  Value="White"/>
                <Setter Property="BorderBrush" Value="#00796B"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinWidth" Value="110"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="Black"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Foreground"      Value="Black"/>
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderBrush"     Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="6"/>

            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Foreground"      Value="Black"/>
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderBrush"     Value="#00796B"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>
        </Grid.Resources>

        <ScrollViewer>
            <StackPanel Padding="30" Spacing="20">

                <!-- TÍTULO -->
                <TextBlock Text="REPORTES DE CITAS"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#00796B"/>

                <!-- ======================================================= -->
                <!--                      FILTROS                             -->
                <!-- ======================================================= -->
                <Border Background="White" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="15">

                        <TextBlock Text="Filtros de búsqueda"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#00796B"/>

                        <!-- FILA 1: Buscar + Doctor + Botones -->
                        <Grid ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- BUSCAR PACIENTE -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Buscar por folio de cita" FontSize="12" Foreground="Black"/>
                                <TextBox x:Name="txtBuscar"
                                         Height="40"/>
                            </StackPanel>

                            <!-- DOCTOR -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Doctor" FontSize="12" Foreground="Black"/>
                                <ComboBox x:Name="cbFiltroDoctor"
                                          HorizontalAlignment="Stretch"
                                          Height="40"/>
                            </StackPanel>

                            <!-- BOTÓN BUSCAR -->
                            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Bottom">
                                <TextBlock Text=" " FontSize="12"/>
                                <Button Content="Buscar"
                                        Width="110"
                                        Height="40"
                                        Background="#00796B"
                                        Foreground="White"
                                        CornerRadius="6"
                                        Click="Buscar_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- FILA 2: Rango de fechas mejorado -->
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" 
                                    Background="#F1F3F4" 
                                    CornerRadius="8" 
                                    Padding="15,10" 
                                    BorderBrush="#E0E0E0" 
                                    BorderThickness="1">

                                <StackPanel Orientation="Horizontal" Spacing="15">
                                    <!-- Icono o Etiqueta de Sección -->
                                    <FontIcon Glyph="&#xEC92;" 
                                            FontSize="16" 
                                            Foreground="#00796B" 
                                            VerticalAlignment="Center" 
                                            Margin="0,0,5,0"/>

                                    <!-- DESDE -->
                                    <StackPanel Spacing="2">
                                            <TextBlock Text="DESDE" 
                                                    FontSize="10" 
                                                    FontWeight="Bold" 
                                                    Foreground="#5F6368" 
                                                    CharacterSpacing="100"/>
                                        <DatePicker x:Name="dpDesde" 
                                                    Width="220" 
                                                    Foreground="Black"
                                                    BorderThickness="0,0,0,1" 
                                                    BorderBrush="#00796B"/>
                                    </StackPanel>
                                        <!-- HASTA -->
                                    <StackPanel Spacing="2">
                                            <TextBlock Text="HASTA" 
                                                    FontSize="10" 
                                                    FontWeight="Bold" 
                                                    Foreground="#5F6368" 
                                                    CharacterSpacing="100"/>
                                    <DatePicker x:Name="dpHasta" 
                                               Width="220" 
                                                    Foreground="Black"
                                                    BorderThickness="0,0,0,1" 
                                                    BorderBrush="#00796B"/>

                                    </StackPanel>
                                    </StackPanel>
                            </Border>

                                <!-- CHIP de rango activo -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                <Border x:Name="chipRango"
                                            Background="#E0F2F1"
                                            CornerRadius="20"
                                            Padding="12,8"
                                            Visibility="Collapsed"
                                            HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="txtChipRango"
                                               FontSize="12"
                                               Foreground="#00796B"
                                               VerticalAlignment="Center"/>
                                        <Button Content="✕"
                                            FontSize="10"
                                            Width="22" Height="22"
                                            Padding="0"
                                            Background="Transparent"
                                            Foreground="#00796B"
                                            Click="LimpiarFechas_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ======================================================= -->
                <!--                   RESULTADOS                             -->
                <!-- ======================================================= -->
                <Border Background="White" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="10">

                        <!-- Encabezado con contador -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Resultados"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#00796B"/>

                            <Border Grid.Column="1"
                                    Background="#E0F2F1"
                                    CornerRadius="12"
                                    Padding="10,4">
                                <TextBlock x:Name="txtContador"
                                           Text="0 citas"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#00796B"/>
                            </Border>
                        </Grid>

                        <ListView x:Name="lvResultados"
                                  Height="320"
                                  Background="#F9F9F9"
                                  BorderBrush="#EEEEEE"
                                  BorderThickness="1">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:Cita">
                                    <Border Background="White"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="4"
                                            BorderBrush="#DDDDDD"
                                            BorderThickness="1">
                                        <Grid ColumnSpacing="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock FontWeight="Bold" Foreground="Black">
                                                    <Run Text="Folio: "/>
                                                    <Run Text="{x:Bind Id}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="Black">
                                                    <Run Text="Paciente: "/>
                                                    <Run Text="{x:Bind Nombre}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="Black">
                                                    <Run Text="Doctor: "/>
                                                    <Run Text="{x:Bind Doctor}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="Black">
                                                    <Run Text="Hora: "/>
                                                    <Run Text="{x:Bind Hora}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="12" Foreground="Gray">
                                                    <Run Text="Fecha: "/>
                                                    <Run Text="{x:Bind FechaCitaFormateada}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Foreground="Black">
                                                    <Run Text="Motivo: "/>
                                                    <Run Text="{x:Bind Motivo}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="Black">
                                                    <Run Text="Edad: "/>
                                                    <Run Text="{x:Bind Edad}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="Black">
                                                    <Run Text="Enfermedades: "/>
                                                    <Run Text="{x:Bind EnfermedadesTexto}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="Black">
                                                    <Run Text="Cirugías: "/>
                                                    <Run Text="{x:Bind CirugiasTexto}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- ======================================================= -->
                <!--                     ESTADÍSTICAS                         -->
                <!-- ======================================================= -->

                <!-- Encabezado de estadísticas + chip de contexto -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Estadísticas"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#00796B"
                               VerticalAlignment="Center"/>

                    <Border Grid.Column="1"
                            x:Name="chipContexto"
                            Background="#FFF3E0"
                            CornerRadius="20"
                            Padding="14,6"
                            Visibility="Collapsed">
                        <TextBlock x:Name="txtChipContexto"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#E65100"/>
                    </Border>
                </Grid>

                <!-- FILA 1: Dona + Barras días -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- GRÁFICA 1: Dona citas por doctor -->
                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Citas por doctor"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#00796B"/>
                            <!-- Canvas centrado -->
                            <Grid HorizontalAlignment="Center">
                                <Canvas x:Name="canvasDoctores"
                                        Width="220"
                                        Height="220"
                                        Background="#F9F9F9"/>
                            </Grid>
                            <ItemsControl x:Name="leyendaDoctores">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,4,6,0">
                                            <Border Width="12" Height="12" CornerRadius="2"
                                                    Background="{Binding Color}"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Etiqueta}"
                                                       FontSize="11"
                                                       Foreground="Black"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- GRÁFICA 2: Días de la semana -->
                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Días con más citas"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#00796B"/>
                            <Canvas x:Name="canvasDias"
                                    Height="220"
                                    Background="#F9F9F9"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- FILA 2: Edades + Línea por mes -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- GRÁFICA 3: Distribución de edades -->
                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Distribución de edades"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#00796B"/>
                            <Canvas x:Name="canvasEdades"
                                    Height="220"
                                    Background="#F9F9F9"/>
                        </StackPanel>
                    </Border>

                    <!-- GRÁFICA 4: Citas por mes -->
                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Citas por mes"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#00796B"/>
                            <Canvas x:Name="canvasMeses"
                                    Height="220"
                                    Background="#F9F9F9"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
